# Local infrastructure (docker-compose.yml). Copy to .env — `make setup` does this for you.
# App-level settings live in each app's own env files (server_playground/, client_playground/).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=playground_dev
# 5433 avoids clashing with other local Postgres instances on the default 5432.
POSTGRES_PORT=5433
