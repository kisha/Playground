# Optional overrides for client_application. Copy to .env.local (git-ignored) to use them.
# Defaults for each environment live in src/lib/env.ts; you only need this file to override them.
# NEXT_PUBLIC_ values are built into the browser bundle: restart `bun run dev` or rebuild after changes.

# development | staging | production (default: development for `dev`, production for `build`)
# NEXT_PUBLIC_APP_ENV=development

# Where the API lives (default for development: http://localhost:8000/api/v1)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Source repository linked from the landing page. Set this in your copy of Playground.
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/<you>/UTTC_Playground

# Show the /sandbox page (default: on, except in production)
# NEXT_PUBLIC_SANDBOX_ENABLED=true
